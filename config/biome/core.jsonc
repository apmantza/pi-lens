{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error",
				"noUndeclaredVariables": "warn"
			},
		"style": {
			// Off (refs #2385): its "safe" fix rewrites value imports to
			// `import type` for imports used only in type positions, which
			// erases the runtime binding that experimental decorator metadata
			// (`emitDecoratorMetadata` -> design:type) still needs — verified
			// against real biome 2.5.9 + tsc: the emitted design:type identity
			// changes from the imported class to `Function`. Biome's own rule
			// docs recommend disabling this rule for such repos. Explicit
			// project biome.json(c) configs remain authoritative and unaffected.
			"useImportType": "off",
			"useConst": "error",
				"useTemplate": "error",
				"noNegationElse": "error",
				"noNestedTernary": "error",
				"noParameterAssign": "error",
				"noNonNullAssertion": "warn",
				"useBlockStatements": "warn",
				"useCollapsedElseIf": "warn"
			},
			"complexity": {
				"noForEach": "error",
				"noExcessiveCognitiveComplexity": {
					"level": "warn",
					"options": {
						"maxAllowedComplexity": 20
					}
				},
				"useOptionalChain": "warn",
				"noAdjacentSpacesInRegex": "warn"
			},
			"performance": {
				"noAccumulatingSpread": "warn",
				"noBarrelFile": "warn"
			},
			"security": {
				"noBlankTarget": "error",
				"noDangerouslySetInnerHtml": "error",
				"noGlobalEval": "error"
			},
			"a11y": {
				"recommended": true
			},
			"suspicious": {
				"recommended": true,
				"noDebugger": "error",
				"noDoubleEquals": "error",
				"noEmptyInterface": "warn",
				"noExplicitAny": "warn"
			},
			"nursery": {
				"useSortedClasses": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "es5",
			"semicolons": "always"
		}
	},
	"overrides": [
		{
			"includes": ["**/*.{test,spec}.{ts,tsx,js,jsx}"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off",
						"noExplicitAny": "off"
					},
					"complexity": {
						"noExcessiveCognitiveComplexity": "off"
					}
				}
			}
		}
	]
}
