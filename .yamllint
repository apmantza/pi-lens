# yamllint config (dogfood activation, refs #1844). Scopes yamllint to the
# YAML tracked by the repository, including rule catalogs and workflows, and
# tunes only high-volume style rules. Warnings stay visible as advisories.
extends: default

ignore: |
  node_modules/
  # Runner fixtures intentionally exercise malformed/unusual YAML.
  tests/fixtures/

rules:
  line-length:
    # GitHub Actions `run:`/`if:` lines routinely exceed 80 columns (up to
    # 253 in this tree's workflows) — a style choice this repo hasn't made,
    # not a real defect. Same precedent as the oxlint/typos configs in this
    # PR: downgrade to advisory rather than raise the threshold and lose the
    # check's ability to flag a genuinely runaway line.
    level: warning
  document-start:
    # Existing workflows and config YAML don't start with `---`; not worth
    # a mass rewrite to satisfy a style preference this repo hasn't made.
    present: false
  truthy:
    # GitHub Actions' `on:` trigger key is the canonical yamllint false
    # positive for workflow files (YAML 1.1 treats "on" as boolean).
    # check-keys: false stops MAP KEYS being truthy-checked while still
    # catching a genuine bare yes/no/on VALUE elsewhere.
    check-keys: false
