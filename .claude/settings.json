{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PROJECT_DIR}/scripts/hooks/guard-bash.mjs\"",
						"timeout": 5
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": "startup|resume",
				"hooks": [
					{
						"type": "command",
						"command": "node scripts/prune-agent-worktrees.mjs --hook session-start --quiet",
						"timeout": 90
					}
				]
			}
		],
		"SubagentStop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node scripts/prune-agent-worktrees.mjs --hook subagent-stop --quiet",
						"timeout": 15
					}
				]
			}
		]
	}
}
